# Gemini API key (script, voice, alignment; images too if IMAGE_PROVIDER=api)
GEMINI_API_KEY=your_gemini_api_key

# Channel used when --channel is not passed: codigo_capital (default) or tio_warren
DEFAULT_CHANNEL=codigo_capital

# Image provider: playwright (Flow web app through the Flow Image Automator extension) or api (Gemini image API)
IMAGE_PROVIDER=playwright
# Your Flow project URL and the built extension folder (.output/chrome-mv3 of flow-image-automator)
FLOW_PROJECT_URL=
FLOW_EXTENSION_PATH=

# whisper.cpp CLI binary (Windows build by default)
WHISPER_CLI_PATH=bin/whisper/whisper-cli.exe
